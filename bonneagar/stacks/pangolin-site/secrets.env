# =============================================================================
# PANGOLIN SITE — Locket Secrets Template (dev-baile)
# =============================================================================
# Pangolin Site credentials for the v1.23+ tunnel agent.
# Vault: dev-baile
#
# Per the 2026-09-26-pangolin-newt-v1.23-upgrade-v1 openspec change (Stage 2a).
# This template REPLACES the legacy newt.secrets.env (which used NEWT_ID + NEWT_SECRET).
# The Pangolin Site uses SITE_ID + SITE_SECRET.
#
# Note: Existing Newt deployments continue to work (per v1.23 docs: "Newt will
# continue to be provided in all of its current forms for the foreseeable future").
# Migrate to Pangolin Site when convenient.
# =============================================================================

# arm1-oci (OCI ARM instance)
PANGOLIN_SITE_ARM1_ID={{ infisical://dev-baile/pangolin/newt-arm1-oci/id }}
PANGOLIN_SITE_ARM1_SECRET={{ infisical://dev-baile/pangolin/newt-arm1-oci/secret }}

# bunchloch (MacBook M4 workload host)
PANGOLIN_SITE_BUNCHLOCH_ID={{ infisical://dev-baile/pangolin/newt-bunchloch/id }}
PANGOLIN_SITE_BUNCHLOCH_SECRET={{ infisical://dev-baile/pangolin/newt-bunchloch/secret }}

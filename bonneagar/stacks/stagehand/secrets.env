# =============================================================================
# STAGEHAND - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# All keys live in the cianchosaint vault under /stagehand/.
# To create the vault entries, run:
#   bun run scripts/init-vault.ts   # alias: mise run secrets:init
#
# INFISICAL SECRETS TO CREATE:
#   - stagehand-llm: openai_api_key, anthropic_api_key, deepseek_api_key,
#       google_api_key
#   - stagehand-browserbase: browserbase_api_key, browserbase_project_id
#       (optional; only needed if you want to fall back to Browserbase cloud)
# =============================================================================

# =============================================================================
# LLM Provider API Keys (Stagehand uses these to drive the browser)
# =============================================================================
OPENAI_API_KEY=infisical://dev-baile/cianchosaint/stagehand/openai_api_key
ANTHROPIC_API_KEY=infisical://dev-baile/cianchosaint/stagehand/anthropic_api_key
DEEPSEEK_API_KEY=infisical://dev-baile/cianchosaint/stagehand/deepseek_api_key
GOOGLE_API_KEY=infisical://dev-baile/cianchosaint/stagehand/google_api_key

# =============================================================================
# Browserbase cloud fallback (optional)
# =============================================================================
BROWSERBASE_API_KEY=infisical://dev-baile/cianchosaint/stagehand/browserbase_api_key
BROWSERBASE_PROJECT_ID=infisical://dev-baile/cianchosaint/stagehand/browserbase_project_id

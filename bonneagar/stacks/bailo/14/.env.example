# =============================================================================
# BAILO - Local Development Environment (stack 14)
# =============================================================================
# Copy this file to .env.local and edit values as needed.
# For production, secrets come from Locket/Infisical via sidecar.yaml.
#
# Usage: cp .env.example .env.local

# =============================================================================
# Bailo Service
# =============================================================================
IMAGE=ghcr.io/gchq/bailo
TAG=2.0.0
LOCKET_MODE=watch

# =============================================================================
# Bailo backend configuration
# (set in .env.local for dev, or via Locket/Infisical in production)
# =============================================================================
# BAILO_JWT_SECRET=...                  # Set via Locket/Infisical in production
# BAILO_API_TOKEN=...                   # Set via Locket/Infisical in production
# BAILO_MONGO_URL=mongodb://bailo-mongo:27017/bailo
# BAILO_MINIO_URL=http://bailo-minio:9000
# BAILO_REDIS_URL=redis://bailo-redis:6379

# =============================================================================
# MinIO (Bailo's S3-compatible blob store)
# =============================================================================
BAILO_MINIO_ROOT_USER=bailo
BAILO_MINIO_ROOT_PASSWORD=bailo
BAILO_MINIO_IMAGE=minio/minio
BAILO_MINIO_TAG=RELEASE.2024-09-13T20-26-02Z

# =============================================================================
# MongoDB (Bailo's primary metadata store)
# =============================================================================
BAILO_MONGO_IMAGE=mongo:7.0

# =============================================================================
# Redis (Bailo's session / cache store)
# =============================================================================
BAILO_REDIS_IMAGE=redis:7.2-alpine

# =============================================================================
# Locket sidecar
# =============================================================================
# INFISICAL_CLIENT_ID=...               # Set via Locket/Infisical in production
# INFISICAL_SECRET_FILE=../../infisical_secret
# INFISICAL_FALLBACK_FILE=./env-fallback.env

# =============================================================================
# GAFFER - Locket Secrets Template (stack 15)
# =============================================================================
# Template file for Locket secret injection.
# Uses Infisical references (infisical:///<SECRET_KEY>).
#
# USAGE:
#   locket exec --provider infisical \
#     --connect.host http://132.145.27.89:8080 \
#     --connect.token-file /path/to/token \
#     --env-file secrets.env \
#     -- docker compose -f compose.yaml up -d
#
# INFISICAL SECRETS TO CREATE:
#   - gaffer: gaffer_rest_api_key
# =============================================================================

# =============================================================================
# Gaffer REST API auth (per hmgcc/Gaffer/rest-api/README.md)
# =============================================================================
GAFFER_REST_API_KEY=infisical://dev-baile/gaffer/rest-api-key

# =============================================================================
# Gaffer store configuration
# =============================================================================
GAFFER_STORE_TYPE=map
GAFFER_GRAPH_ID=cianchosaint_cross_source

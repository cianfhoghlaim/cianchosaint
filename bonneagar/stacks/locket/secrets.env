# =============================================================================
# LOCKET - Locket Self-Test Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# The Locket stack uses its OWN template file (not the consumer stack's) for
# the standalone self-test bring-up. The consumer stack's template is mounted
# as /templates/secrets.env via sidecar.yaml. Both flow through the same
# Infisical resolver.
#
# To run the Locket self-test, create the following vault entries:
#   - locket-selftest: locket_selftest_marker (any non-empty string)
#
# This template is mostly a placeholder that proves the resolution loop
# works end-to-end. The real consumer stacks have their own secrets.env files.
# =============================================================================

# Self-test marker — confirms Locket resolved at least one secret
LOCKET_SELFTEST_MARKER=infisical://dev-baile/cianchosaint/locket/locket_selftest_marker

# Infisical machine identity (consumed by Locket to call the Infisical API)
INFISICAL_CLIENT_ID=infisical://dev-baile/cianchosaint/locket/client_id
INFISICAL_PROJECT_ID=infisical://dev-baile/cianchosaint/locket/project_id

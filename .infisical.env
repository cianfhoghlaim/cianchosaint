# =============================================================================
# Cianchosaint — Infisical env template (.infisical.env)
# =============================================================================
#
# This file is the **template**. It is COMMITTED to git. It contains NO
# secret values — only `infisical://dev-baile/cianchosaint/<key>` URIs that
# resolve at runtime via the Infisical `dev-baile` environment.
#
# The corresponding runtime `.env` file is gitignored and is hydrated by
# `mise run secrets:init` (or `bun run scripts/init-vault.ts`) plus the
# Locket sidecar in production containers.
#
# NEVER edit this file to add secret values. NEVER hand-edit `.env`.
# Per the Cianchosaint `LICENSE.md` and the Infisical + mise + Locket
# three-way contract: secrets are auto-hydrated.
# =============================================================================

# -----------------------------------------------------------------------------
# cianchosaint — top-level secret folder
# -----------------------------------------------------------------------------
CIANCHOSAINT_INFISICAL_FOLDER=cianchosaint

# -----------------------------------------------------------------------------
# 4-tier model provider chain (per `ModelProviderRouter`)
# -----------------------------------------------------------------------------

# Tier 1 (PRIMARY) — Unsloth Studio (local API; Pangolin ingress later)
UNSLOTH_STUDIO_API_KEY=infisical://dev-baile/cianchosaint/unsloth-studio/api-key
UNSLOTH_STUDIO_BASE_URL=http://unsloth-serve:8889/api/v1

# Tier 2 — LiteLLM Proxy (existing Cianfhoghlaim stack)
LITELLM_BASE_URL=https://litellm.cianfhoghlaim.ie
LITELLM_MASTER_KEY=infisical://dev-baile/litellm/master-key
LITELLM_TIMEOUT_SECONDS=30

# Tier 3 — MiniMax Token Plan (direct API)
MINIMAX_TOKEN_PLAN_KEY=infisical://dev-baile/cianchosaint/minimax/token-plan-key
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Tier 4 (LAST RESORT) — Gemini API
GEMINI_API_KEY=infisical://dev-baile/cianchosaint/gemini/api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Circuit-breaker config
MODEL_PROVIDER_CIRCUIT_BREAKER_THRESHOLD=3
MODEL_PROVIDER_CIRCUIT_BREAKER_RESET_SECONDS=60

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# Langfuse (observability for every LLM call)
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/cianchosaint/langfuse/public-key
LANGFUSE_SECRET_KEY=infisical://dev-baile/cianchosaint/langfuse/secret-key
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_TRACING_ENABLED=true

# -----------------------------------------------------------------------------
# Storage (MotherDuck + Lakehouse + LanceDB)
# -----------------------------------------------------------------------------

# MotherDuck (per-tenant: cianchosaint has its own service account)
MOTHERDUCK_TOKEN=infisical://dev-baile/cianchosaint/motherduck/token
MOTHERDUCK_DATABASE=md:cianchosaint

# Lakehouse (Garage S3 + Postgres + Lakekeeper — shared with Cianfhoghlaim)
LAKEHOUSE_S3_ENDPOINT=http://lakehouse-garage:3900
LAKEHOUSE_S3_BUCKET=cianchosaint-lakehouse
LAKEHOUSE_S3_ACCESS_KEY=infisical://dev-baile/lakehouse/s3-access-key
LAKEHOUSE_S3_SECRET_KEY=infisical://dev-baile/lakehouse/s3-secret-key
LAKEHOUSE_POSTGRES_HOST=lakehouse-postgres
LAKEHOUSE_POSTGRES_DB=cianchosaint
LAKEHOUSE_POSTGRES_USER=cianchosaint
LAKEHOUSE_POSTGRES_PASSWORD=infisical://dev-baile/lakehouse/postgres-cianchosaint-password
LAKEHOUSE_LAKEKEEPER_URL=http://lakehouse-lakekeeper:8181

# LanceDB (per-tenant)
LANCEDB_URI=infisical://dev-baile/cianchosaint/lancedb/uri

# -----------------------------------------------------------------------------
# BAML client config
# -----------------------------------------------------------------------------
BAML_CLIENT_TIMEOUT_SECONDS=30
BAML_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# OSINT source allowlist
# -----------------------------------------------------------------------------
CIANCHOSAINT_OSINT_ALLOWLIST_PATH=dlt_sources/cianchosaint/common/osint_allowlist.yaml
CIANCHOSAINT_OSINT_ALLOWLIST_REJECT_ON_MISSING=true

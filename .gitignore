# -----------------------------------------------------------------------------
# Cianchosaint .gitignore — mirrors Cianfhoghlaim's .gitignore conventions.
# -----------------------------------------------------------------------------

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# Bun / Node
node_modules/
dist/
build/
.turbo/
.next/
out/

# Mise
.mise/

# CocoIndex
.cocoindex_code/target_*.db
.cocoindex_code/cocoindex.db

# Local env (NEVER commit .env — Infisical hydrates it)
.env
.env.local
.env.*.local
.env.temp

# Infisical env (template is .infisical.env, committed; runtime .env is gitignored)
.infisical.env.local

# Coverage
.coverage
htmlcov/
coverage/
.nyc_output/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors
.idea/
.vscode/
*.swp

# OS-specific
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Dagster
.dagster_home/
.tmp_dagster_home_*/

# CI
.cache/

# TypeScript build
.tsbuildinfo

# Temporary / scratch
.scratch/
.tmp/
.tmp_*/

# Nested git repos in .agents/skills
.agents/skills/copilotkit/

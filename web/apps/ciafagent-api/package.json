{
  "name": "@cianchosaint/ciafagent-api",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "cd apps/api && bun run dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check --write .",
    "clean": "turbo clean",
    "start": "cd apps/api && bun run start"
  },
  "dependencies": {
    "@cianchosaint/auth": "workspace:*",
    "@cianchosaint/ciafagent-ui-kit": "workspace:*",
    "@cianchosaint/db": "workspace:*",
    "@cianchosaint/ui-kit": "workspace:*",
    "@hono/node-server": "^1.0.0",
    "@orpc/openapi": "^1.12.0",
    "@orpc/server": "^1.12.0",
    "@orpc/zod": "^1.12.0",
    "convex": "^1.40.0",
    "dotenv": "^17.2.2",
    "hono": "^4.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "turbo": "^2.6.0",
    "@biomejs/biome": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/bun": "^1.2.6"
  },
  "packageManager": "bun@1.3.0"
}
